{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "category",
          "evidenceType",
          "timestamp",
          "timestampSeconds",
          "historicalDate",
          "videoEvidence"
        ],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 240 },
          "category": {
            "type": "string",
            "enum": [
              "quote",
              "publication",
              "event",
              "financial_crisis",
              "regulation",
              "executive_statement",
              "other"
            ]
          },
          "evidenceType": {
            "type": "string",
            "enum": ["direct_quote", "paraphrase", "reference"]
          },
          "timestamp": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}:\\d{2}$"
          },
          "timestampSeconds": { "type": "integer", "minimum": 0 },
          "historicalDate": { "type": ["string", "null"], "maxLength": 160 },
          "videoEvidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    }
  }
}
