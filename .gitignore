# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
.opencode
opencode.*
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local runtime state
/.runtime/
/.codex-loop/
/.cache/
/.cbm-mcp/

# Legacy raw Takeout payload is preserved on disk, not versioned here.
/_deprecated/t001-legacy-baseline/content/articles/raw-takeout/*.tgz
