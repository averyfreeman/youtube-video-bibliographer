# Python environments and generated bytecode
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local secrets and environment files
.env
.env.*
!.env.example

# Raw Takeout inputs, extracted data, staging runs, and local backups
/inbox/
/downloads/
/takeout/
/staging/
/backup/
/_article_pipeline_state/
/*.tgz
/*.tar
/*.tar.gz
/*.zip

# Published articles live in the separate private article repository. Keep the
# publication mount and all generated article output out of this public repo.
/articles/
/articles/_article_pipeline/
/articles/drafts/
/articles/inbox/
/articles/**/*.tmp
/articles/article_surgeon_progress_tree.md

# Local Airflow state
/airflow/logs/*
!/airflow/logs/.gitkeep
/airflow/config/*
!/airflow/config/.gitkeep
/airflow/plugins/*
!/airflow/plugins/.gitkeep
