# Optional: use a separate Codex authentication directory for this prototype.
# CODEX_HOME=/absolute/path/to/codex-home

# Optional: override the installed Codex executable.
# CODEX_CLI_PATH=/Applications/ChatGPT.app/Contents/Resources/codex

# Optional: override the installed Antigravity CLI executable or OAuth model.
# AGY_CLI_PATH=/home/avery/.local/bin/agy
# AGY_MODEL=gemini-4-hydrogen

# Optional: enable Google Gemini API provider (default model: gemini-4-hydrogen).
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-4-hydrogen
